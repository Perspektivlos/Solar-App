# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Solar-Lokal Backend (server.ts)
# ---------------------------------------------------------------------------
PORT=3000
# Mosquitto mit TLS + ACL (Venus-Bridge N/<VRM-ID>/... und TRUCKI/#)
MQTT_ENABLED=true
MQTT_URL="mqtts://192.168.0.201:8883"
MQTT_USERNAME="mqttapp"
MQTT_PASSWORD=""
# Pfad zur CA der eigenen OpenSSL-Zertifikate
MQTT_CA_FILE="/etc/solar-app/ca.crt"
MQTT_REJECT_UNAUTHORIZED=true
# Venus OS VRM Portal-ID
VRM_ID="b827eb79321c"
# MQTT-Prefix = Geraetename im T2SG
TRUCKI_TOPIC_PREFIX="TRUCKI"
# Optionale Ueberschreibungen der Geraete-URLs
# SHELLY_URL="http://192.168.0.100"
# AHOY_URL="http://192.168.0.101"
# TRUCKI_URL="http://192.168.0.102"
